accessWidener	v2	named

# RenderLayer.of is package-private and RenderLayer has no public constructor, so there is no
# vanilla or Fabric API path to a custom render layer. TrarnCore needs one: drawing highlights
# through terrain requires a pipeline with DepthTestFunction.NO_DEPTH_TEST, and no vanilla layer
# combines that with a lines or quads vertex format.
#
# Declaring it here means it is opened once for the whole family rather than per mod — consuming
# mods call Layers.seeThroughLines() and never touch RenderLayer.of themselves.
#
# Unlike a mixin this changes no behaviour. If the signature moves in a future Minecraft version
# the build fails loudly, which is the failure mode we want.
accessible	method	net/minecraft/client/render/RenderLayer	of	(Ljava/lang/String;Lnet/minecraft/client/render/RenderSetup;)Lnet/minecraft/client/render/RenderLayer;
