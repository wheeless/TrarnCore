{
  "schemaVersion": 1,
  "id": "simdistance",
  "version": "${version}",
  "name": "SimDistance",
  "description": "Draws a tall, translucent red wall on the chunk borders at your simulation-distance edge so you can instantly see which chunks around you are actually being ticked. Client-side only.",
  "authors": [
    "Trarn"
  ],
  "contact": {
    "sources": "https://github.com/wheeless/TrarnCore/tree/main/SimDistance",
    "issues": "https://github.com/wheeless/TrarnCore/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.simdistance.SimDistance"
    ],
    "modmenu": [
      "net.simdistance.integration.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": ">=1.21 <1.22",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config": "*"
  }
}
